<body class="page-shell">
  <div class="scroll-progress" aria-hidden="true"></div>

  {% include "header.njk" %}

  <main id="contenido">
    <!-- HERO INSTITUCIONAL -->
    <section class="section section-soft">
      <div class="container">
        <div class="section-heading reveal">
          <p class="eyebrow">Institucional</p>
          <h1>Centro de Kinesiología y Fisiatría Kareh</h1>
          <p>
            Atención clínica personalizada en Bella Vista, orientada a la recuperación real de cada paciente mediante
            diagnóstico funcional, calidez humana y respaldo profesional constante.
          </p>
        </div>

        <div class="about-grid about-grid--spaced">
          <div class="about-copy reveal">
            <h2>Nuestra filosofía de trabajo</h2>
            <p>
              En Kareh entendemos la rehabilitación como un proceso integral. Creemos que cada paciente merece tiempo,
              escucha atenta y un plan terapéutico pensado a su medida, sin protocolos masivos ni tratamientos impersonales.
            </p>
            <p>
              Combinamos evaluación kinésica rigurosa, ejercicios terapéuticos específicos y tecnología de apoyo para
              recuperar la funcionalidad, reducir el dolor y brindar las herramientas necesarias para prevenir recaídas.
            </p>
            <p>
              Atendemos pacientes de Bella Vista, San Miguel, Muñiz, José C. Paz y Hurlingham en un espacio confortable,
              luminoso y preparado para tu bienestar.
            </p>
          </div>

          <div class="about-points">
            <article class="info-card reveal">
              <span class="card-kicker">Propósito</span>
              <h3>Atención individual y responsable</h3>
              <p>Cada sesión persigue un objetivo concreto para mejorar tu movilidad y calidad de vida cotidiana.</p>
            </article>

            <article class="info-card reveal">
              <span class="card-kicker">Confianza</span>
              <h3>Acompañamiento en cada etapa</h3>
              <p>Explicamos con claridad tu evolución, resolviendo dudas y adaptando las cargas según tu respuesta física.</p>
            </article>
          </div>
        </div>
      </div>
    </section>

    <!-- DIRECCIÓN PROFESIONAL -->
    <section class="section" id="profesional">
      <div class="container">
        <div class="section-heading reveal">
          <p class="eyebrow">Dirección Profesional</p>
          <h2>Lic. Katia Aluminé Romero</h2>
          <h3>Licenciada en Kinesiología y Fisiatría</h3>
        </div>

        <article class="profile-card profile-card--simple reveal">
          <div class="profile-image-shell">
            <img class="profile-image" src="/assets/img/IMG-20260111-384.webp?v=20260323"
              srcset="/assets/img/IMG-20260111-384.webp?v=20260323 384w, /assets/img/IMG-20260111-512.webp?v=20260323 512w"
              sizes="(min-width: 720px) 20rem, calc(100vw - 2rem)" alt="Lic. Katia Aluminé Romero, kinesióloga"
              width="384" height="634" loading="lazy" decoding="async">
          </div>

          <div class="profile-content">
            <span class="profile-role">Responsable Técnica del Centro</span>
            <h3>Planificación responsable, criterio clínico y vocación asistencial.</h3>
            <p class="profile-copy"><strong>Lic. en Kinesiología y Fisiatría · M.P. 10.318 · M.N. 18.900</strong></p>
            <p class="profile-copy">
              Especializada en rehabilitación traumatológica, kinesiología respiratoria pediátrica y abordaje de piso pélvico.
              La atención se orienta a comprender el cuadro médico de origen y diseñar un programa kinésico que acompañe
              al paciente en cada sesión hacia su autonomía y bienestar.
            </p>
            <p class="profile-copy">
              Formación académica continua en técnicas avanzadas de fisioterapia, reeducación postural y disfunciones pelviperineales.
            </p>
          </div>
        </article>
      </div>
    </section>

    <!-- NUESTRO CONSULTORIO -->
    <section class="section section-soft" id="instalaciones">
      <div class="container">
        <div class="section-heading reveal">
          <p class="eyebrow">Espacio y Equipamiento</p>
          <h2>Nuestras instalaciones en Bella Vista</h2>
          <p>
            Ubicados estratégicamente sobre Av. Senador Morón 782, nuestro centro cuenta con consultorios equipados,
            sala de espera climatizada y aparatología terapéutica moderna (magnetoterapia, ultrasonido y electroanalgesia).
          </p>
        </div>

        <div class="cards-grid cards-grid--three">
          <article class="service-card reveal">
            <img src="/assets/consultorio/consultorio-box-1.jpg" alt="Consultorio box individual Kareh" style="width: 100%; height: 180px; object-fit: cover; border-radius: 8px;" loading="lazy">
            <span class="card-kicker button--top-sm">Boxes de atención</span>
            <h3>Privacidad y confort</h3>
            <p>Espacios individuales para evaluaciones kinésicas, tratamientos de piso pélvico y fisioterapia analgésica.</p>
          </article>

          <article class="service-card reveal">
            <img src="/assets/consultorio/magnetoterapia-ultrasonido.jpg" alt="Equipos de ultrasonido y magnetoterapia" style="width: 100%; height: 180px; object-fit: cover; border-radius: 8px;" loading="lazy">
            <span class="card-kicker button--top-sm">Equipamiento clínico</span>
            <h3>Aparatología de apoyo</h3>
            <p>Aparatos de magnetoterapia, ultrasonido terapéutico y corrientes analgésicas para optimizar los tiempos de cicatrización y alivio.</p>
          </article>

          <article class="service-card reveal">
            <img src="/assets/consultorio/sala-de-espera.jpg" alt="Sala de espera y recepción Kareh" style="width: 100%; height: 180px; object-fit: cover; border-radius: 8px;" loading="lazy">
            <span class="card-kicker button--top-sm">Recepción</span>
            <h3>Puntualidad y calidez</h3>
            <p>Coordinación organizada con turnos escalonados para evitar esperas innecesarias y brindar atención dedicada.</p>
          </article>
        </div>

        <div class="hero-actions button--top-md reveal">
          <a class="button button-primary" href="https://wa.me/5491132016039?text=Hola%2C%20quisiera%20consultar%20por%20atenci%C3%B3n%20en%20Kareh." target="_blank" rel="noopener noreferrer" data-conversion="turno" data-segment="particular">Escribir por WhatsApp</a>
          <a class="button button-secondary" href="/servicios/">Ver todos los servicios</a>
          <a class="button button-secondary" href="/obras-sociales/">Consultar obras sociales</a>
        </div>
      </div>
    </section>
