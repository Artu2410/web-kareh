<footer class="site-footer">
  <div class="container footer-grid">
    <div class="footer-intro">
      <a class="brand footer-brand" href="/">
        <span class="brand-logo-shell">
          <img class="brand-logo" src="/assets/img/logo-icon-192.png?v=20260323"
            srcset="/assets/img/logo-icon-96.png?v=20260323 96w, /assets/img/logo-icon-192.png?v=20260323 192w, /assets/img/logo-icon-240.png?v=20260323 240w"
            sizes="80px" alt="Kareh - Centro de Kinesiología y Fisiatría" width="192" height="136" loading="lazy"
            decoding="async">
        </span>
        <span class="brand-copy"><small>Kinesiología y Fisiatría</small></span>
      </a>
      <p class="footer-copy">La atención presencial se brinda únicamente en Bella Vista. Recibimos pacientes de San Miguel, Muñiz, José C. Paz y zonas aledañas en nuestro consultorio.</p>
    </div>
    <div class="footer-card">
      <h3>Contacto</h3>
      <a class="footer-link" href="{{ site.address.mapUrl }}" target="_blank" rel="noopener noreferrer">{{ site.address.label }}</a>
      {% for schedule in site.hours %}
      <p class="footer-meta">{{ schedule.days }} {{ schedule.time }}</p>
      {% endfor %}
      <a class="footer-link" href="{{ site.whatsappDefaultText | waLink(site.whatsapp) }}" target="_blank" rel="noopener noreferrer" data-conversion="turno" data-segment="particular">WhatsApp: {{ site.whatsappDisplay }}</a>
    </div>
    <div class="footer-card">
      <h3>Profesional y redes</h3>
      <p class="footer-meta">{{ site.professional.name }}</p>
      <p class="footer-meta">{{ site.professional.credentials }}</p>
      <div class="footer-socials">
        <a class="social-link" href="{{ site.social.instagram }}" target="_blank" rel="noopener noreferrer" aria-label="Instagram de Kareh"><span>Instagram</span></a>
        <a class="social-link" href="{{ site.social.facebook }}" target="_blank" rel="noopener noreferrer" aria-label="Facebook de Kareh"><span>Facebook</span></a>
      </div>
    </div>
    <div class="footer-card">
      <h3>Servicios</h3>
      {% for item in nav.primary[0].children %}
      <a class="footer-link" href="{{ item.url }}">{{ item.label }}</a>
      {% endfor %}
    </div>
    <div class="footer-card">
      <h3>Pacientes de zonas cercanas</h3>
      {% for item in nav.footer.localities %}
      <a class="footer-link" href="{{ item.url }}">{{ item.label }}</a>
      {% endfor %}
    </div>
    <div class="footer-card">
      <h3>Información</h3>
      {% for item in nav.footer.information %}
      <a class="footer-link" href="{{ item.url }}">{{ item.label }}</a>
      {% endfor %}
    </div>
  </div>
  <div class="container footer-bottom">
    <p>&copy; <span id="year"></span> Kareh. Todos los derechos reservados.</p>
  </div>
</footer>
{% set navContext = nav.contexts[page.url] or {} %}
{% set ctaClass = "whatsapp-float" %}
{% set ctaLabel = "Pedir turno" %}
{% set ctaAriaLabel = "Pedir turno por WhatsApp" %}
{% set ctaService = navContext.service %}
{% set ctaSegment = navContext.segment %}
{% set ctaCoverage = navContext.coverage %}
{% include "partials/cta-whatsapp.njk" %}
