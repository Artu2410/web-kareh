{%- if serviceFaq %}
<section class="section section-soft" aria-labelledby="preguntas-servicio">
  <div class="container">
    <div class="section-heading reveal">
      <p class="eyebrow">Preguntas frecuentes</p>
      <h2 id="preguntas-servicio">{{ serviceFaqTitle | default("Dudas habituales sobre este tratamiento") }}</h2>
    </div>
    <div class="faq-group reveal">
      {%- for item in serviceFaq %}
      <article class="faq-item">
        <button class="faq-trigger" type="button" data-accordion-trigger aria-expanded="false" aria-controls="sfaq-{{ loop.index }}">
          <span>{{ item.q }}</span>
          <span class="faq-indicator">+</span>
        </button>
        <div class="faq-panel" id="sfaq-{{ loop.index }}" hidden>
          <p>{{ item.a }}</p>
        </div>
      </article>
      {%- endfor %}
    </div>
    <p class="service-faq-more reveal">¿Tenés otra duda? Mirá todas las <a href="/preguntas/">preguntas frecuentes</a> o escribinos por <a href="{{ site.whatsappDefaultText | waLink(site.whatsapp) }}" target="_blank" rel="noopener noreferrer" data-conversion="turno">WhatsApp</a>.</p>
  </div>
</section>
{%- endif %}
