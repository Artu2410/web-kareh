{% set navContext = nav.contexts[page.url] or {} %}
<header class="site-header" id="top">
  <div class="container nav-shell">
    <a class="brand" href="/" aria-label="Ir al inicio de Kareh">
      <span class="brand-logo-shell">
        <img class="brand-logo" src="/assets/img/logo-icon-192.png?v=20260323"
          srcset="/assets/img/logo-icon-96.png?v=20260323 96w, /assets/img/logo-icon-192.png?v=20260323 192w, /assets/img/logo-icon-240.png?v=20260323 240w"
          sizes="80px" alt="Kareh - Centro de Kinesiología y Fisiatría" width="192" height="136" decoding="async">
      </span>
      <span class="brand-copy"><small>Kinesiología y Fisiatría</small></span>
    </a>
    <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="site-nav" aria-label="Abrir menú">
      <span></span><span></span>
    </button>
    <nav class="site-nav" id="site-nav" aria-label="Principal">
      {% for item in nav.primary %}
        {% if item.children %}
      <div class="nav-dropdown">
        <a href="{{ item.url }}"{% if page.url == item.url %} aria-current="page"{% endif %}>{{ item.label }}</a>
        <button class="nav-dropdown-toggle" type="button" aria-expanded="false" aria-label="Mostrar opciones de {{ item.label }}" aria-controls="service-menu"></button>
        <div class="nav-dropdown-menu" id="service-menu" hidden>
          {% for child in item.children %}
          <a href="{{ child.url }}"{% if page.url == child.url %} aria-current="page"{% endif %}>{{ child.label }}</a>
          {% endfor %}
        </div>
      </div>
        {% else %}
      <a href="{{ item.url }}"{% if page.url == item.url %} aria-current="page"{% endif %}>{{ item.label }}</a>
        {% endif %}
      {% endfor %}
      {% set ctaClass = "nav-cta" %}
      {% set ctaLabel = "Pedir turno" %}
      {% set ctaService = navContext.service %}
      {% set ctaSegment = navContext.segment %}
      {% set ctaCoverage = navContext.coverage %}
      {% include "partials/cta-whatsapp.njk" %}
    </nav>
  </div>
</header>
{% if nav.breadcrumbs[page.url] %}{% include "partials/breadcrumbs.njk" %}{% endif %}
