

.hero-panel h2 {
  font-size: clamp(1.55rem, 3.5vw, 2.05rem);
}

.panel-badge {
  display: inline-flex;
  width: fit-content;
  padding: 0.45rem 0.8rem;
  border-radius: 999px;
  background: rgba(107, 196, 181, 0.16);
  color: #2d7f78;
  font-weight: 800;
  font-size: 0.82rem;
}

.hero-panel p {
  color: var(--kareh-info);
  max-width: 34ch;
}

.panel-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 0.9rem;
}

.panel-grid--three {
  grid-template-columns: 1fr;
}

.panel-grid article {
  padding: 1rem;
  border-radius: 1.3rem;
  background: rgba(255, 255, 255, 0.86);
  border: 1px solid rgba(95, 124, 138, 0.1);
  transition: transform 0.25s ease, border-color 0.25s ease, box-shadow 0.25s ease;
}

.panel-grid article:hover {
  transform: translateY(-4px);
  border-color: rgba(107, 196, 181, 0.24);
  box-shadow: 0 16px 30px rgba(46, 58, 63, 0.08);
}

.panel-grid strong,
.profile-highlights strong {
  display: block;
  font-family: var(--font-display);
  font-size: 1.1rem;
}

.panel-grid span,
.profile-highlights span {
  color: var(--kareh-text-muted);
  font-size: 0.92rem;
}

.floating-note {
  position: absolute;
  right: 0;
  display: grid;
  gap: 0.3rem;
  width: min(100%, 18rem);
  padding: 1.05rem 1.15rem;
  border-radius: 1.5rem;
  box-shadow: var(--kareh-shadow-soft);
  animation: softFloat 7s ease-in-out infinite;
}

.note-primary {
  top: 1rem;
  background: linear-gradient(135deg, rgba(107, 196, 181, 0.96), rgba(168, 230, 207, 0.9));
}

.note-accent {
  bottom: 0;
  left: 1.5rem;
  right: auto;
  background: linear-gradient(135deg, rgba(244, 166, 160, 0.96), rgba(255, 227, 224, 0.9));
}

.note-label {
  font-size: 0.78rem;
  font-weight: 800;
  letter-spacing: 0.08em;
  text-transform: uppercase;
}

.floating-note strong {
  line-height: 1.35;
}

.section-heading {
  position: relative;
  z-index: 1;
  display: grid;
  gap: 0.75rem;
  margin-bottom: 1.75rem;
  max-width: 38rem;
}

.about-copy,
.about-points {
  position: relative;
  z-index: 1;
}

.about-copy {
  display: grid;
  gap: 1rem;
}

.about-points {
  display: grid;
  gap: 1rem;
  align-content: start;
}

.info-card,
.service-card,
.badge-card,
.location-card,
.transport-card {
  position: relative;
  z-index: 1;
  padding: 1.6rem;
  transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
}

.info-card:hover,
.service-card:hover,
.badge-card:hover,
.location-card:hover,
.transport-card:hover,
.profile-card:hover {
  transform: translateY(-4px);
  box-shadow: var(--kareh-shadow);
  border-color: rgba(107, 196, 181, 0.28);
}

.card-kicker,
.profile-role {
  display: inline-flex;
  margin-bottom: 0.7rem;
  color: #397d74;
  font-weight: 800;
  font-size: 0.8rem;
  letter-spacing: 0.08em;
  text-transform: uppercase;
}

.card-kicker--stacked {
  display: block;
  margin-top: 0.75rem;
}

.profile-card {
  display: grid;
  gap: 1.5rem;
  padding: 1.5rem;
  border: 1px solid var(--kareh-border);
  border-radius: calc(var(--kareh-radius) + 0.4rem);
  background: linear-gradient(135deg, rgba(255, 255, 255, 0.96), rgba(255, 255, 255, 0.78));
  box-shadow: var(--kareh-shadow-soft);
  transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
}

.profile-card--simple .profile-content {
  display: grid;
  gap: 0.75rem;
  align-content: start;
}

.profile-card--simple h3 {
  font-size: clamp(1.1rem, 2.2vw, 1.35rem);
  color: var(--kareh-text);
  line-height: 1.3;
}

.profile-image-shell {
  display: grid;
  width: 18rem;
  height: 18rem;
  aspect-ratio: 1 / 1;
  border-radius: 50%;
  overflow: hidden;
  border: 3px solid rgba(107, 196, 181, 0.4);
  box-shadow: 0 0 0 6px rgba(107, 196, 181, 0.1), var(--kareh-shadow-soft);
  background:
    radial-gradient(circle at top left, rgba(255, 255, 255, 0.42), transparent 38%),
    linear-gradient(180deg, #dcecef, #eef5f6);
  justify-self: center;
}

.profile-image {
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: center 18%;
}

.profile-content {
  display: grid;
  gap: 1.25rem;
}

.profile-header {
  display: grid;
  gap: 0.45rem;
}

.profile-copy {
  color: var(--kareh-info);
  max-width: 60ch;
}

.profile-columns,
.profile-highlights,
.cards-grid,
.badge-grid,
.faq-grid,
.footer-grid {
  display: grid;
  gap: 1rem;
}

.detail-list,
.transport-list {
  margin: 0;
  padding-left: 1.15rem;
  color: var(--kareh-info);
  font-size: 0.97rem;
  line-height: 1.7;
}

.detail-list li + li,
.transport-list li + li {
  margin-top: 0.5rem;
}

.detail-list--top-tight {
  margin-top: 0.5rem;
}

.transport-copy {
  margin-bottom: 0.95rem;
}

.area-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 0.65rem;
  margin: 1rem 0 1.25rem;
}

.area-tags--centered {
  justify-content: center;
  gap: 0.75rem;
  margin: 0;
}

/* Secciones nuevas para conversión y obras sociales rápidas */
.hero-benefits {
  margin: 0.6rem 0 0;
  padding: 0;
  list-style: none;
  display: flex;
  gap: 1rem;
  color: var(--kareh-info);
  font-weight: 700;
}

.section-coverage-quick .coverage-list {
  display: flex;
  flex-wrap: wrap;
  gap: 0.8rem 1rem;
  align-items: center;
  margin-top: 0.8rem;
}

.section-coverage-quick .coverage-list span {
  padding: 0.5rem 0.9rem;
  border-radius: 999px;
  background: rgba(255,255,255,0.85);
  border: 1px solid var(--kareh-border);
  color: var(--kareh-text);
  font-weight: 800;
}

.section-conversion .conversion-steps ol {
  margin: 0.6rem 0 0;
  padding-left: 1.1rem;
  color: var(--kareh-info);
}

/* Reducir ornamentos en hero para enfocarnos en conversión */
.hero-backdrop { display: none !important; }

.area-tag {
  display: inline-flex;
  align-items: center;
  padding: 0.45rem 0.8rem;
  border: 1px solid rgba(107, 196, 181, 0.2);
  border-radius: 999px;
  background: rgba(107, 196, 181, 0.14);
  color: #2d7f78;
  font-size: 0.82rem;
  font-weight: 800;
  letter-spacing: 0.02em;
  transition: transform 0.2s ease, background-color 0.2s ease, border-color 0.2s ease;
}

.area-tag--link {
  text-decoration: none;
}

.dashboard-page {
  padding-bottom: 4rem;
}

.soft-bg {
  background: rgba(255, 255, 255, 0.92);
  border-radius: 2rem;
  box-shadow: var(--kareh-shadow-soft);
  padding: 2rem;
}

.metrics-grid,
.messages-grid,
.seo-grid,
.agenda-summary {
  display: grid;
  gap: 1.25rem;
}

.metrics-grid {
  grid-template-columns: repeat(auto-fit, minmax(190px, 1fr));
}

.metric-card {
  border-radius: 1.5rem;
  padding: 1.5rem;
  background: #ffffff;
  border: 1px solid rgba(95, 124, 138, 0.1);
  box-shadow: var(--kareh-shadow-soft);
}

.metric-card-primary {
  background: rgba(107, 196, 181, 0.12);
}

.metric-card-accent {
  background: rgba(244, 166, 160, 0.12);
}

.metric-card-info {
  background: rgba(77, 103, 116, 0.11);
}

.metric-card-danger {
  background: rgba(244, 166, 160, 0.18);
}

.metric-label {
  display: block;
  margin-bottom: 0.75rem;
  color: var(--kareh-text-muted);
  text-transform: uppercase;
  letter-spacing: 0.08em;
  font-size: 0.78rem;
}

.metric-card strong {
  display: block;
  font-size: 2rem;
  line-height: 1.1;
  color: var(--kareh-text);
}

.agenda-summary {
  grid-template-columns: 1fr;
}

.agenda-card {
  border-radius: 1.75rem;
  padding: 1.5rem;
  background: #ffffff;
  box-shadow: var(--kareh-shadow-soft);
  border: 1px solid rgba(95, 124, 138, 0.08);
}

.table-wrapper {
  overflow-x: auto;
}

.table-dashboard {
  width: 100%;
  border-collapse: collapse;
  text-align: left;
}

.table-dashboard th,
.table-dashboard td {
  padding: 0.95rem 1rem;
  border-bottom: 1px solid rgba(95, 124, 138, 0.08);
}

.table-dashboard th {
  color: var(--kareh-info);
  font-weight: 700;
  font-size: 0.9rem;
}

.table-dashboard td {
  font-size: 0.95rem;
  color: var(--kareh-text);
}

.status-badge {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 0.5rem 0.85rem;
  border-radius: 999px;
  color: #fff;
  font-size: 0.8rem;
  font-weight: 700;
}

.badge-particular {
  background: #4d6774;
}


.badge-ioma {
  background: #176f64;
}

.badge-sancor {
  background: #91c7d0;
}

.badge-medife {
  background: #7256b8;
}

.badge-ospe {
  background: #d68845;
}

.badge-list {
  display: flex;
  flex-wrap: wrap;
  gap: 0.75rem;
}

.copy-btn {
  margin-top: 1rem;
}

.messages-grid,
.seo-grid {
  grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
}

.message-card,
.seo-card {
  border-radius: 1.5rem;
  background: #ffffff;
  padding: 1.5rem;
  box-shadow: var(--kareh-shadow-soft);
  border: 1px solid rgba(95, 124, 138, 0.08);
}

.message-card h3,
.seo-card h3 {
  margin-top: 0;
  font-size: 1.05rem;
}

.message-card p,
.seo-card p,
.seo-card ul {
  color: var(--kareh-text-muted);
  line-height: 1.7;
}

.export-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 1rem;
}

@media (min-width: 720px) {
  .agenda-summary {
    grid-template-columns: 1fr 1fr;
  }
}

.area-tag:hover {
  transform: translateY(-2px);
  background: rgba(107, 196, 181, 0.2);
  border-color: rgba(107, 196, 181, 0.3);
}

.info-card h3,
.faq-card h3 {
  margin-bottom: 0.55rem;
}

.info-card--centered {
  text-align: center;
}

.metric-value {
  font-size: 2.5rem;
  font-weight: 800;
  color: var(--accent, #0ea5e9);
}

.metric-title {
  margin-top: 0.25rem;
}

.reviews-grid {
  position: relative;
  z-index: 1;
  display: grid;
  gap: 1.5rem;
  align-items: stretch;
}

.reviews-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 0.9rem;
  margin-top: 0.5rem;
}

.reviews-panel {
  display: grid;
  gap: 1rem;
  padding: 1.1rem;
  border: 1px solid var(--kareh-border);
  border-radius: var(--kareh-radius);
  background: rgba(255, 255, 255, 0.78);
  box-shadow: var(--kareh-shadow-soft);
  backdrop-filter: blur(10px);
}

.reviews-panel h3 {
  margin: 0;
}

.reviews-proof {
  display: grid;
  gap: 1.15rem;
  padding: 1.5rem;
  border: 1px solid var(--kareh-border);
  border-radius: var(--kareh-radius);
  background:
    linear-gradient(180deg, rgba(255, 255, 255, 0.96), rgba(255, 255, 255, 0.86)),
    linear-gradient(135deg, rgba(107, 196, 181, 0.14), rgba(244, 166, 160, 0.08));
  box-shadow: var(--kareh-shadow-soft);
  backdrop-filter: blur(10px);
}

.reviews-rating {
  display: inline-flex;
  align-items: center;
  gap: 0.7rem;
  width: fit-content;
  padding: 0.65rem 0.95rem;
  border-radius: 999px;
  background: rgba(255, 255, 255, 0.92);
  border: 1px solid rgba(217, 144, 36, 0.16);
}

.reviews-rating strong {
  color: var(--kareh-text);
  font-size: 1rem;
  line-height: 1.1;
}

.reviews-proof-list {
  display: grid;
  gap: 0.9rem;
}

.review-quote-card {
  display: grid;
  gap: 0.6rem;
  padding: 1.2rem 1.25rem;
  border: 1px solid rgba(95, 124, 138, 0.12);
  border-radius: 1.3rem;
  background: linear-gradient(180deg, rgba(255,255,255,0.96), rgba(248,250,251,0.92));
  box-shadow: 0 10px 20px rgba(46, 58, 63, 0.03);
}