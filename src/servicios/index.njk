  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "¿Qué tratamientos ofrece Kareh?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Kareh ofrece rehabilitación traumatológica y postoperatoria, kinesiología respiratoria para adultos y pediátrica, rehabilitación de piso pélvico —que integra el abordaje de incontinencia urinaria— y ultrasonido terapéutico como apoyo según evaluación."
          }
        },
        {
          "@type": "Question",
          "name": "¿Atienden niños?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "La atención pediátrica se realiza únicamente en tratamientos respiratorios."
          }
        },
        {
          "@type": "Question",
          "name": "¿Qué aparatología utilizan?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Según la evaluación clínica, Kareh utiliza magnetoterapia, ultrasonido y electroanalgesia como apoyo al tratamiento."
          }
        },
        {
          "@type": "Question",
          "name": "¿Qué modalidades de atención tienen?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Trabajamos con distintas modalidades de atención. Antes de comenzar revisamos la orden médica y la documentación necesaria para organizar cada caso de forma adecuada."
          }
        }
