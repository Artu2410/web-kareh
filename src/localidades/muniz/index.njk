  "schema": [
    {
      "@context": "https://schema.org",
      "@type": "Service",
      "name": "Kinesiología para pacientes de Muñiz",
      "serviceType": "Kinesiología y rehabilitación",
      "provider": {
        "@type": "MedicalBusiness",
        "@id": "https://kareh.com.ar/#medicalbusiness",
        "name": "Kareh - Centro de Kinesiología y Fisiatría",
        "url": "https://kareh.com.ar/",
        "telephone": "+5491132016039",
        "address": {
          "@type": "PostalAddress",
          "streetAddress": "Av. Senador Morón 782",
          "addressLocality": "Bella Vista",
          "addressRegion": "Buenos Aires",
          "addressCountry": "AR"
        }
      },
      "areaServed": {
        "@type": "City",
        "name": "Muñiz"
      },
      "description": "Kinesiología y rehabilitación en Bella Vista para pacientes de Muñiz. Tratamientos de traumatología, respiratoria y piso pélvico."
    }
  ],
  "bodyClass": "page-shell page-shell--compact"
